# Configure these only on SS07's server. Never put a real key in this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
HOST_ORIGINS=http://localhost:3000
DATA_DIR=./data
DAILY_REQUEST_CAP=100
DAILY_TOKEN_BUDGET=200000
RATE_PER_MINUTE=6
GLOBAL_PER_MINUTE=30
MAX_CONCURRENT=3
PROVIDER_TIMEOUT_MS=25000
# Enable only behind a controlled proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Production requires a separate random secret, at least 32 characters.
IP_HASH_SECRET=
NODE_ENV=development
